{
  "name": "query",
  "version": "1.0.0",
  "description": "Wrappers around frequently used 3rd-party APIs.",
  "main": "dist/worker.js",
  "scripts": {
    "build": "esbuild src/app.ts --bundle --outfile=dist/worker.js --format=esm --target=esnext",
    "clean": "rm -rf dist",
    "clean:node": "rm -rf node_modules",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev src/app.ts",
    "dev:local": "npx tsx --env-file .env src/server.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint --fix \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Juan Villela",
  "license": "MIT",
  "packageManager": "pnpm@10.28.2",
  "lint-staged": {
    "*.ts": [
      "pnpm format",
      "pnpm lint"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "hono": "^4.12.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260120.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.9",
    "@vitest/coverage-v8": "4.0.18",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pnpm": "^10.28.2",
    "prettier": "^3.8.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.68.0"
  }
}
