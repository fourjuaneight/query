{
  "name": "query",
  "version": "1.0.0",
  "description": "Wrappers around frequently used 3rd-party APIs.",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist",
    "clean:node": "rm -rf node_modules",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev src/app.ts",
    "dev:local": "tsx --env-file .env src/server.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint --fix \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "author": "Juan Villela",
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.28.2",
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  }
}
